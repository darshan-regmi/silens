{
  "expo": {
    "name": "silens",
    "slug": "silens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "silens",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/626a0b7e-9ded-44f8-8bc4-ebf23b04e20e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.darshanregmi.silens",
      "supportsTablet": true,
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.darshanregmi.silens",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "owner": "darshan_regmi",
    "extra": {
      "eas": {
        "projectId": "626a0b7e-9ded-44f8-8bc4-ebf23b04e20e"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}
